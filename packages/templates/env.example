# Tossana agent kit — copy to .env and fill in. NEVER commit .env.

# Your own ClickUp token: ClickUp → avatar → Settings → Apps → API Token
CLICKUP_API_TOKEN=

# Your ClickUp user ID: receives the "ready for review" notification.
# Find it with: tossana-agents clickup spaces
CLICKUP_OWNER_USER_ID=

# Optional: custom runner command for pipeline.runner = "custom".
# {agent} and {prompt} are replaced, e.g. opencode run --agent {agent} {prompt}
AGENT_CMD=
