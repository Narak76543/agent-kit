{
  "name": "@tossana/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @tossana/agents-core build",
    "dev": "next dev --port 3100",
    "prebuild": "pnpm --filter @tossana/agents-core build",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "pnpm --filter @tossana/agents-core build && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@tossana/agents-core": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
